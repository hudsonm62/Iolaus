{
    "trailingComma": "none",
    "endOfLine": "lf",
    "useTabs": false,
    "tabWidth": 4,
    "overrides": [
        {
            "files": ["*.mcmeta"],
            "options": {
                "parser": "json",
                "tabWidth": 4
            }
        },
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}
